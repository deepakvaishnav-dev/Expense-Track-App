{
  "expo": {
    "name": "Expense Tracker AI",
    "slug": "expense-tracker-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expensetracker.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.expensetracker.ai",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload receipts.",
          "cameraPermission": "The app needs access to your camera to capture receipts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "633dc25c-cdc1-43fe-b915-da2c4c49a1e8"
      }
    }
  }
}

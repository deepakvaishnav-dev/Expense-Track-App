# ==============================================================================
# Backend Environment Configuration Template
# Duplicate this file as '.env' and fill in the values for deployment.
# ==============================================================================

# Server Environment: 'development' or 'production'
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# PostgreSQL Connection String (Asyncpg driver)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:your_strong_password@localhost:5432/expense_tracker

# Cryptographic Keys (Must be strong, minimum 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_random_32_character_string_for_secret_key_here
REFRESH_SECRET_KEY=generate_a_different_random_32_char_string_for_refresh_here

# Fernet 32-byte URL-safe base64 Encryption Key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate_fernet_key_using_command_above

# Google Gemini API Key (Required for AI categorization & OCR receipt parsing)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
